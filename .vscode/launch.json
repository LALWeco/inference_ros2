    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Extract images bag",
            "type": "debugpy",
            "request": "launch",
            "program": "src/inference_ros2/scripts/extract_images_rosbag.py",
            "args": [
                "/home/docker/bag_data/2025_06_auto_exposure_camera/",
                "/home/docker/bag_data/2025_06_auto_exposure_camera/images",
                "--topic", "/oak/rgb/image_raw/compressed",
                "--nth", "11",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Detection launch",
            "type": "ros2",
            "request": "launch",
            "preLaunchTask": "build",
            "target": "/home/docker/ros2_ws/install/inference_ros2/share/inference_ros2/launch/inference.launch.py"
        },
        {
            "name": "Tracking launch",
            "type": "ros2",
            "request": "launch",
            "preLaunchTask": "build",
            "target": "/home/docker/ros2_ws/install/inference_ros2/share/inference_ros2/launch/tracking.launch.py"
        },
    ]
}