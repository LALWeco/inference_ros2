{
    "name": "Lalweco Inference ROS2 Development",
    "build": {
        "dockerfile": "../docker/amd64/Dockerfile_dev",
        "context": "..",
        "args": {
            "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
        }
    },
    "workspaceFolder": "/home/docker/ros2_ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/docker/ros2_ws/src/inference_ros2,type=bind",
    "runArgs": [
        "--gpus=all",
        "--network=host",
        "--runtime=nvidia",
        "--ipc=host",
        "-e", "TERM=xterm-256color",
        "-v", "/dev/shm:/dev/shm"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-vscode.cpptools",
                "ms-iot.vscode-ros",
                "twxs.cmake",
                "ms-vscode.cmake-tools"
            ]
        }
    },
    "remoteUser": "docker"
}